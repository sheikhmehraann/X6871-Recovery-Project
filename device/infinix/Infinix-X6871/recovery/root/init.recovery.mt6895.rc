import /init.tee.rc
import /init.device.rc

on early-init
    wait /dev/block/platform/soc/112b0000.ufshci
    symlink /dev/block/platform/soc/112b0000.ufshci /dev/block/bootdevice
    symlink /dev/block/platform/soc/112b0000.ufshci/by-name /dev/block/bootdevice/by-name
    symlink /dev/block/platform/soc/112b0000.ufshci/by-name /dev/block/by-name

on init
    restorecon /kmsg
    restorecon_recursive /sys/devices/platform/soc/soc:mtk-leds
    restorecon_recursive /sys/devices/platform/soc/soc:regulator-vibrator/leds/vibrator
    restorecon /sys/devices/platform/soc/mt_usb/saving
    symlink /tmp/fstab /etc/fstab
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "11201000.usb0"
    setprop sys.usb.ffs.aio_compat 1
    setprop crypto.ready 1

    # Exact Stock Device Identity (Infinix GT 20 Pro - X6871)
    setprop ro.product.model "Infinix X6871"
    setprop ro.product.marketname "Infinix GT 20 Pro"
    setprop ro.product.device "X6871"
    setprop ro.product.name "X6871-OP"
    setprop ro.product.brand "Infinix"
    setprop ro.product.manufacturer "INFINIX"
    setprop ro.product.board "mt6895"
    setprop ro.board.platform "MediaTek Dimensity 8200 Ultimate (MT6895)"
    setprop ro.build.product "X6871"
    setprop ro.twrp.target.devices "X6871,Infinix-X6871,Infinix_X6871,X6871-OP"

    # Hardware blockdevice symlinks
    wait /dev/block/platform/soc/112b0000.ufshci
    symlink /dev/block/platform/soc/112b0000.ufshci /dev/block/bootdevice
    symlink /dev/block/platform/soc/112b0000.ufshci/by-name /dev/block/bootdevice/by-name
    symlink /dev/block/platform/soc/112b0000.ufshci/by-name /dev/block/by-name

    # Mount /metadata for vold metadata encryption key (Android 16 GKI)
    wait /dev/block/by-name/metadata
    mount ext4 /dev/block/by-name/metadata /metadata noatime nosuid nodev discard
    mkdir /metadata/vold 0700 root root
    mkdir /metadata/vold/metadata_encryption 0700 root root
    mkdir /metadata/recovery 0770 root root
    chmod 0770 /metadata/recovery
    rm /cache
    symlink /metadata/recovery /cache

    # Mount /mnt/vendor/persist for Trustonic TEE (mobicore mcRegistry)
    wait /dev/block/by-name/persist
    mkdir /mnt/vendor/persist 0771 system system
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist noatime nosuid nodev
    chown system system /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist
    mkdir /mnt/vendor/persist/mcRegistry 0771 system system
    chown system system /mnt/vendor/persist/mcRegistry
    chmod 0771 /mnt/vendor/persist/mcRegistry
    mkdir /data/vendor 0775 system system
    mkdir /data/vendor/mcRegistry 0775 system system

    # Install session keyring for dm-default-key
    install_keyring

    # Hardware drivers for touch & flashlight
    insmod /lib/modules/spi-mt65xx.ko
    insmod /lib/modules/tui-common.ko
    insmod /lib/modules/adaptive-ts.ko
    insmod /lib/modules/gt9916_common.ko
    insmod /lib/modules/focaltech_ft3683g.ko
    insmod /lib/modules/gt9896s.ko
    insmod /lib/modules/mtk_mdpm.ko
    insmod /lib/modules/mtk_dynamic_loading_throttling.ko
    insmod /lib/modules/mtk_pbm.ko
    insmod /lib/modules/flashlight.ko
    insmod /lib/modules/ocp81375_v4l2.ko
    insmod /lib/modules/sgm37864_v4l2.ko

    # Flashlight bridge for OrangeFox GUI (real rear camera torch)
    mkdir /flashlight 0777 root root
    rm /flashlight/brightness
    symlink /sys/class/torch/torch/torch_level /flashlight/brightness
    write /flashlight/max_brightness 1
    chmod 0777 /flashlight
    chmod 0666 /flashlight/brightness
    chmod 0666 /flashlight/max_brightness
    chmod 0666 /sys/class/torch/torch/torch_level
    chmod 0666 /sys/devices/virtual/torch/torch/torch_level

    # Haptics & Vibration (both AW8697 vibrator_single and MT6368 regulator-vibrator)
    chmod 0666 /sys/class/leds/vibrator/duration
    chmod 0666 /sys/class/leds/vibrator/activate
    chmod 0666 /sys/class/leds/vibrator/state
    chmod 0666 /sys/class/leds/vibrator/brightness
    chmod 0666 /sys/class/leds/vibrator_single/duration
    chmod 0666 /sys/class/leds/vibrator_single/activate
    chmod 0666 /sys/class/leds/vibrator_single/state
    chmod 0666 /sys/class/leds/vibrator_single/brightness
    symlink /sys/class/leds/vibrator_single /sys/class/leds/vibrator

    # TEE Device node permissions for KeyMint and Keystore2
    chmod 0666 /dev/mobicore
    chmod 0666 /dev/mobicore-user
    chmod 0666 /dev/teeperf

on property:persist.vendor.mtk.pl_lnk=1
    symlink /dev/block/mapper/pl_a /dev/block/by-name/preloader_raw_a
    symlink /dev/block/mapper/pl_b /dev/block/by-name/preloader_raw_b
    symlink /dev/block/mapper/pl_a /dev/block/platform/bootdevice/by-name/preloader_raw_a
    symlink /dev/block/mapper/pl_b /dev/block/platform/bootdevice/by-name/preloader_raw_b

    symlink /dev/block/by-name/lk1 /dev/block/by-name/bootloader1
    symlink /dev/block/by-name/lk2 /dev/block/by-name/bootloader2

on property:vendor.mtk.boot0_linka=1
    symlink /dev/block/sda /dev/block/mmcblk0boot0

on property:vendor.mtk.boot0_linkb=1
    symlink /dev/block/sdb /dev/block/mmcblk0boot0

on property:vendor.mtk.boot0_linkc=1
    symlink /dev/block/sdc /dev/block/mmcblk0boot0

on property:vendor.mtk.boot1_linka=1
    symlink /dev/block/sda /dev/block/mmcblk0boot1

on property:vendor.mtk.boot1_linkb=1
    symlink /dev/block/sdb /dev/block/mmcblk0boot1

on property:vendor.mtk.boot1_linkc=1
    symlink /dev/block/sdc /dev/block/mmcblk0boot1

on property:servicemanager.ready=true
    setprop sys.boot_completed 1
    mkdir /tmp/misc 0777 root root
    mkdir /tmp/misc/keystore 0777 root root
    start mobicore
    start keystore2
    start vendor.keymint-trustonic
    start vendor.gatekeeper-default
    start tee-service

on property:ro.crypto.state=encrypted
    start mobicore
    start keystore2
    start vendor.keymint-trustonic
    start vendor.gatekeeper-default
    start tee-service

on property:ro.vendor.trustonic.ready=true
    start tee-service
    start vendor.gatekeeper-default

on boot
    setprop sys.usb.config adb
    mkdir /tmp/misc 0777 root root
    mkdir /tmp/misc/keystore 0777 root root
    start mobicore
    start keystore2
    start vendor.keymint-trustonic
    start vendor.gatekeeper-default
    start tee-service
    write /sys/fs/selinux/enforce 0

# Gatekeeper AIDL service
service vendor.gatekeeper-default /vendor/bin/hw/android.hardware.gatekeeper-service.trustonic
    class early_hal
    interface aidl android.hardware.gatekeeper.IGatekeeper/default
    user root
    group root system
    disabled
    seclabel u:r:recovery:s0

# Keymint AIDL service (Trustonic RKP v1)
service vendor.keymint-trustonic /vendor/bin/hw/android.hardware.security.keymint@3.0-service.trustonic --rkp_version=v1
    class early_hal
    interface aidl android.hardware.security.keymint.IKeyMintDevice/default
    interface aidl android.hardware.security.sharedsecret.ISharedSecret/default
    interface aidl android.hardware.security.secureclock.ISecureClock/default
    user root
    group root system drmrpc
    disabled
    seclabel u:r:recovery:s0

# Tee service AIDL
service tee-service /vendor/bin/hw/vendor.trustonic.tee-service
    class early_hal
    user root
    group root system
    disabled
    seclabel u:r:recovery:s0

# Health HAL service definition (root permissions for sysfs battery nodes)
service vendor.health-default /system/bin/hw/android.hardware.health-service.example_recovery
    class hal
    user root
    group root
    capabilities WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w
    seclabel u:r:recovery:s0
    override

# Keystore2 service definition
service keystore2 /system/bin/keystore2 /tmp/misc/keystore
    class early_hal
    interface aidl android.system.keystore2.IKeystoreService/default
    user root
    group root keystore readproc log
    writepid /dev/cpuset/foreground/tasks
    seclabel u:r:recovery:s0
    override
