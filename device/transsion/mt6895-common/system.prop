# Device Identity (Stock Infinix GT 20 Pro X6871)
ro.product.model=Infinix X6871
ro.product.name=X6871-OP
ro.product.brand=Infinix
ro.product.manufacturer=INFINIX
ro.product.device=X6871
ro.build.product=X6871
ro.product.marketname=Infinix GT 20 Pro
ro.orangefox.device_model=Infinix GT 20 Pro
ro.board.platform=mt6895
ro.hardware=mt6895
ro.soc.manufacturer=Mediatek
ro.soc.model=MT6896
ro.twrp.target.devices=X6871,Infinix-X6871,Infinix_X6871,X6871-OP


# OS & Platform
ro.treble.enabled=true

# Display & UI
ro.sf.lcd_density=480

# Hardware & Peripherals
persist.sys.tran_led_support=1
persist.sys.tran_led_gt_support=1
ro.os_alldegree_flashlight_support=1
ro.vendor.tran.vibrator.option=single
ro.tran_vibrate_ontouch.support=1
ro.tran_vibrate_ontouch2.0.support=1

# Thermals
ro.vendor.mtk_thermal_2_0=1
ro.vendor.thermalspace.support=1

# Fstab
ro.postinstall.fstab.prefix=/system

# USB MTP
ro.sys.usb.storage.type=mtp

# Crypto & KeyMint AIDL
keymaster_ver=2
ro.build.version.release=15
ro.build.version.release_or_codename=15
ro.build.version.sdk=35
ro.build.version.security_patch=2026-07-01
ro.vendor.build.security_patch=2026-07-01

# Gatekeeper
ro.hardware.gatekeeper=trustonic

# TEE
ro.vendor.mtk_tee_gp_support=1
ro.vendor.mtk_trustonic_tee_support=1

# Virtual A/B & Snapshot OTA properties for AOSP update_engine
ro.virtual_ab.enabled=true
ro.virtual_ab.compression.enabled=true
ro.virtual_ab.io_uring.enabled=true
ro.virtual_ab.retrofit=false
ro.boot.dynamic_partitions=true
ro.boot.dynamic_partitions_retrofit=false

