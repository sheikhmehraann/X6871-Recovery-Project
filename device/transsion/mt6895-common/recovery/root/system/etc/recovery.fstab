# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#<src>				<mnt_point>		<type>		<mnt_flags and options>															<fs_mgr_flags>
# Logical partitions
system				/system			auto		ro																	wait,slotselect,logical
vendor				/vendor			auto		ro																	wait,slotselect,logical
product				/product		auto		ro																	wait,slotselect,logical
system_ext			/system_ext		auto		ro																	wait,slotselect,logical
odm					/odm			auto		ro																	wait,slotselect,logical
vendor_dlkm			/vendor_dlkm	auto		ro																	wait,slotselect,logical
odm_dlkm			/odm_dlkm		auto		ro																	wait,slotselect,logical
system_dlkm			/system_dlkm	auto		ro																	wait,slotselect,logical
# Transsion partitions
tr_carrier			/tr_carrier		auto		ro																	wait,slotselect,logical
tr_company			/tr_company		auto		ro																	wait,slotselect,logical
tr_mi				/tr_mi			auto		ro																	wait,slotselect,logical
tr_overlayfs		/tr_overlayfs	auto		ro																	wait,slotselect,logical
tr_preload			/tr_preload		auto		ro																	wait,slotselect,logical
tr_product			/tr_product		auto		ro																	wait,slotselect,logical
tr_region			/tr_region		auto		ro																	wait,slotselect,logical
tr_theme			/tr_theme		auto		ro																	wait,slotselect,logical
tr_misc				/tr_misc		auto		ro																	wait,slotselect,logical,nofail
tr_manifest			/tr_manifest	auto		ro																	wait,slotselect,logical,nofail
tr_system			/tr_system		auto		ro																	wait,slotselect,logical,nofail

# ColorOS / RealmeUI / OxygenOS logical partitions
my_product			/my_product		auto		ro																	wait,slotselect,logical,nofail
my_engineering		/my_engineering	auto		ro																	wait,slotselect,logical,nofail
my_company			/my_company		auto		ro																	wait,slotselect,logical,nofail
my_carrier			/my_carrier		auto		ro																	wait,slotselect,logical,nofail
my_region			/my_region		auto		ro																	wait,slotselect,logical,nofail
my_heytap			/my_heytap		auto		ro																	wait,slotselect,logical,nofail
my_stock			/my_stock		auto		ro																	wait,slotselect,logical,nofail
my_preload			/my_preload		auto		ro																	wait,slotselect,logical,nofail
my_bigball			/my_bigball		auto		ro																	wait,slotselect,logical,nofail
my_manifest			/my_manifest	auto		ro																	wait,slotselect,logical,nofail

# Xiaomi / HyperOS / MIUI logical partition
mi_ext				/mi_ext			auto		ro																	wait,slotselect,logical,nofail

# Userdata partition
/dev/block/by-name/metadata	/metadata		ext4		noatime,nosuid,nodev,discard														wait,check,formattable
/dev/block/by-name/userdata	/data			f2fs		noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt				wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption

# Need to have this entry in here even though the mount point itself is no longer needed.
# The update_engine code looks for this entry in order to determine the boot device address
# and fails if it does not find it.
/dev/block/by-name/misc		/misc			emmc		defaults																defaults
/dev/block/by-name/init_boot	/init_boot		emmc		defaults																defaults
