import /init.tee.rc
import /init.device.rc

on early-init
    symlink /system/etc/recovery.fstab /etc/recovery.fstab
    symlink /system/etc/recovery.fstab /fstab.mt6895
    symlink /system/etc/recovery.fstab /fstab.default
    symlink /system/etc/recovery.fstab /vendor/etc/fstab.mt6895
    symlink /system/etc/recovery.fstab /odm/etc/fstab.mt6895
    symlink /system/etc/twrp.flags /etc/twrp.flags
    exec u:r:recovery:s0 -- /system/bin/resetprop -n ro.vendor.build.security_patch 2026-07-01
    exec u:r:recovery:s0 -- /system/bin/resetprop -n ro.build.version.security_patch 2026-07-01

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "11201000.usb0"
    setprop sys.usb.ffs.aio_compat 0
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    setprop crypto.ready 1
    start boot-hal-1-2

    # Exact Stock Device Identity (Infinix GT 20 Pro - X6871)
    setprop ro.product.model "Infinix X6871"
    setprop ro.product.marketname "Infinix GT 20 Pro"
    setprop ro.product.device "X6871"
    setprop ro.product.name "X6871-OP"
    setprop ro.product.brand "Infinix"
    setprop ro.product.manufacturer "INFINIX"
    setprop ro.product.board "mt6895"
    setprop ro.board.platform "MediaTek Dimensity 8200 Ultimate (MT6895)"
    setprop ro.build.product "X6871"
    setprop ro.twrp.target.devices "X6871,Infinix-X6871,Infinix_X6871,X6871-OP"

on fs
    wait /dev/block/platform/soc/112b0000.ufshci
    symlink /dev/block/platform/soc/112b0000.ufshci /dev/block/bootdevice
    symlink /dev/block/by-name /dev/block/bootdevice/by-name
    wait /dev/block/by-name/metadata
    mount ext4 /dev/block/by-name/metadata /metadata noatime nosuid nodev discard
    wait /dev/block/by-name/persist
    mkdir /mnt/vendor/persist 0771 system system
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist noatime nosuid nodev
    chown system system /mnt/vendor/persist
    chmod 0771 /mnt/vendor/persist
    restorecon -R /mnt/vendor/persist
    mkdir /mnt/vendor/persist/mcRegistry 0771 system system
    chown system system /mnt/vendor/persist/mcRegistry
    chmod 0771 /mnt/vendor/persist/mcRegistry
    install_keyring

on post-fs
    start mobicore
    start vendor.gatekeeper-1-0
    start vendor.keymint-trustonic
    start health-hal-2-1

    # Load MediaTek Dimensity 8200 Hardware CPUFreq / Performance Governor driver
    insmod /lib/modules/mediatek-cpufreq-hw.ko

    # Load LVTS CPU thermal driver for real soc_max readings
    insmod /lib/modules/soc_temp_lvts.ko

    # Load flashlight core then camera flash driver
    insmod /lib/modules/flashlight.ko
    insmod /lib/modules/ocp81375.ko
    insmod /lib/modules/sgm37864.ko

    # Load AWINIC / Richtap haptics driver
    insmod /lib/modules/richtap_haptic_hv.ko

    # Haptics legacy symlink for TWRP/OrangeFox UI (after driver load)
    symlink /sys/class/leds/vibrator_single /sys/class/leds/vibrator

on boot
    setprop sys.usb.config adb
    start mtk.plpath.utils.link
    chmod 0755 /system/bin/fox_apply_splash.sh

    # Rear camera flashlight permissions (MediaTek OCP81375)
    chmod 0666 /sys/class/torch/torch/torch_level
    chmod 0666 /sys/devices/virtual/torch/torch/torch_level

    # Haptics & Vibration permissions (MediaTek AW8697 / vibrator_single)
    chmod 0666 /sys/class/leds/vibrator_single/duration
    chmod 0666 /sys/class/leds/vibrator_single/activate
    chmod 0666 /sys/class/leds/vibrator_single/state
    chmod 0666 /sys/class/leds/vibrator_single/vibr_level
    chmod 0666 /sys/class/leds/vibrator_single/brightness
    chmod 0666 /sys/class/leds/vibrator_single/gain
    chmod 0666 /sys/class/leds/vibrator/duration
    chmod 0666 /sys/class/leds/vibrator/activate
    chmod 0666 /sys/class/leds/vibrator/state
    chmod 0666 /sys/class/leds/vibrator/brightness

    # Thermal sensor permissions (MT6895 soc_max)
    chmod 0666 /sys/class/thermal/thermal_zone0/temp
    chmod 0666 /sys/devices/virtual/thermal/thermal_zone0/temp

    # CPU governor & recovery performance mode permissions
    chmod 0666 /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
    chmod 0666 /sys/devices/system/cpu/cpufreq/policy4/scaling_governor
    chmod 0666 /sys/devices/system/cpu/cpufreq/policy7/scaling_governor
    chmod 0666 /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
    chmod 0666 /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor
    chmod 0666 /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor

    # Fast Charge permissions (MediaTek MT6375 / Charger)
    chmod 0666 /sys/class/power_supply/charger/input_current_limit
    chmod 0666 /sys/class/power_supply/charger/constant_charge_current
    chmod 0666 /sys/class/power_supply/battery/current_now



on property:persist.vendor.mtk.pl_lnk=1
    symlink /dev/block/mapper/pl_a /dev/block/by-name/preloader_raw_a
    symlink /dev/block/mapper/pl_b /dev/block/by-name/preloader_raw_b
    symlink /dev/block/mapper/pl_a /dev/block/platform/bootdevice/by-name/preloader_raw_a
    symlink /dev/block/mapper/pl_b /dev/block/platform/bootdevice/by-name/preloader_raw_b

    symlink /dev/block/by-name/lk1 /dev/block/by-name/bootloader1
    symlink /dev/block/by-name/lk2 /dev/block/by-name/bootloader2

on property:vendor.mtk.boot0_linka=1
    symlink /dev/block/sda /dev/block/mmcblk0boot0

on property:vendor.mtk.boot0_linkb=1
    symlink /dev/block/sdb /dev/block/mmcblk0boot0

on property:vendor.mtk.boot0_linkc=1
    symlink /dev/block/sdc /dev/block/mmcblk0boot0

on property:vendor.mtk.boot1_linka=1
    symlink /dev/block/sda /dev/block/mmcblk0boot1

on property:vendor.mtk.boot1_linkb=1
    symlink /dev/block/sdb /dev/block/mmcblk0boot1

on property:vendor.mtk.boot1_linkc=1
    symlink /dev/block/sdc /dev/block/mmcblk0boot1

service mtk.plpath.utils.link /system/bin/mtk_plpath_utils
    class main
    user root
    group root system
    oneshot
    disabled
    seclabel u:r:recovery:s0

service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service vendor.keymint-trustonic /vendor/bin/hw/android.hardware.security.keymint-service.trustonic
    class early_hal
    user system
    group system drmrpc
    disabled
    seclabel u:r:recovery:s0

service health-hal-2-1 /vendor/bin/hw/android.hardware.health@2.1-service
    class hal
    user system
    group system
    disabled
    capabilities WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w
    seclabel u:r:recovery:s0

on property:ro.crypto.state=encrypted
    start mobicore
    start vendor.gatekeeper-1-0
    start vendor.keymint-trustonic
    start health-hal-2-1

on property:servicemanager.ready=true
    setprop sys.boot_completed 1

on property:twrp.decrypt.done=true
    mkdir /data/media/0/Fox 0777 media_rw media_rw
    chmod 0777 /data/media/0/Fox
    chown media_rw media_rw /data/media/0/Fox
    chmod 0666 /data/media/0/Fox/*

